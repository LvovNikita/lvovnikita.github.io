<div class="footer">
    <span>Copyright &copy; <%= new Date().getFullYear() %> <%= config.title %></span>
</div>
<%- css('css/a11y-dark.min.css') %>
<%- js('js/highlight.min.js') %>
<%- js('js/highlightjs-line-numbers.js') %>
<script>
    hljs.initHighlightingOnLoad();
    hljs.initLineNumbersOnLoad();
</script>
<% if (config.mermaid && config.mermaid.enable) { %>
<script src="https://unpkg.com/mermaid@<%= config.mermaid.version %>/dist/mermaid.min.js"></script>
<script>
    mermaid.initialize(<%- JSON.stringify(config.mermaid.options || {}) %>);
</script>
<% } %>
